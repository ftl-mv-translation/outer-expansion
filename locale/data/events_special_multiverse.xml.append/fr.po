#: src-en/data/events_special_multiverse.xml.append:27
msgid ""
"data/events_special_multiverse.xml.append$//event[@name=\"SYLVAN_OE_WEAPONS\"]/text"
msgstr ""
"\"Aaaaah. Étranger, étranger, tout Renégat qui ssse ressspecte sssait qu'il "
"a bezzoin d'équipement pour sssurvivre.\""

#: src-en/data/events_special_multiverse.xml.append:31
msgid ""
"data/events_special_multiverse.xml.append$//event[@name=\"SYLVAN_OE_DRONES\"]/text"
msgstr ""
"\"Aaaaah. Étranger, étranger, je vends normalement des zzarmes, mais j'ai "
"récccemment accumulé un ssstock consssidérable de drones. Peut-être "
"pourriez-vous en utilizzer un ?\""

#: src-en/data/events_special_multiverse.xml.append:35
msgid ""
"data/events_special_multiverse.xml.append$//event[@name=\"SYLVAN_OE_BOTH\"]/text"
msgstr ""
"\"Aaaaah. Étranger étranger, je me sssuis rendu récccemment dans pluzzieurs "
"sssecteurs divers zzet variés, et j'ai trouvé quelques zzarmes rares qui "
"pourraient t'intéresssser.\""

#: src-en/data/events_special_multiverse.xml.append:39
msgid ""
"data/events_special_multiverse.xml.append$//event[@name=\"SYLVAN_OE_LOOT\"]/text"
msgstr ""
"\"Aaaaah. Étranger, étranger, j'ai des zzobjets rares à vendre, étranger !\""

