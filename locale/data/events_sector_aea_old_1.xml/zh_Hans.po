msgid ""
"data/events_sector_aea_old_1.xml$//eventList[@name=\"GUARD_AEA_OLD_1_REQUEST\"]/event[1]/text"
msgstr "\"我很抱歉，但我们没有收到向其他舰船提供援助的命令。\""

#: src-en/data/events_sector_aea_old_1.xml:202
msgid ""
"data/events_sector_aea_old_1.xml$//eventList[@name=\"GUARD_AEA_OLD_1_REQUEST\"]/event[2]/text"
msgstr "守卫似乎对你起了恻隐之心，同意了你的请求。他们移交了一小箱补给。"

#: src-en/data/events_sector_aea_old_1.xml:208
msgid ""
"data/events_sector_aea_old_1.xml$//eventList[@name=\"GUARD_AEA_OLD_1_DEMAND\"]/event/text"
msgstr "守卫拒绝屈服于你的要求。相反，他们举起武器进行了反击。"

#: src-en/data/events_sector_aea_old_1.xml:211
msgid ""
"data/events_sector_aea_old_1.xml$//eventList[@name=\"GUARD_AEA_OLD_1_DEMAND\"]/event/choice/text"
