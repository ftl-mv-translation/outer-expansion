#: src-en/data/events_sector_aea_old_1.xml:223
msgid ""
"data/events_sector_aea_old_1.xml$//event[@name=\"GUARD_AEA_OLD_1_DESTROY\"]/text"
msgstr "你击败了利尔米克守卫。无论他们货舱中曾有何物，定已损毁殆尽，但你至少能从舰船"
"上回收部分物资。"

#: src-en/data/events_sector_aea_old_1.xml:227
msgid ""
"data/events_sector_aea_old_1.xml$//event[@name=\"GUARD_AEA_OLD_1_DEADCREW\"]/text"
msgstr "你击败了利尔米克守卫。船上已无船员阻拦，你可调查其货舱。找到一件武器带回舰船"
"，并继续拆解其舰体回收废料。"

#: src-en/data/events_sector_aea_old_1.xml:246
msgid ""
"data/events_sector_aea_old_1.xml$//event[@name=\"AEA_OLD_1_BARON\"]/beaconType/unvisitedTooltip"
msgstr "这是男爵所在的位置。"

#: src-en/data/events_sector_aea_old_1.xml:247
msgid ""
"data/events_sector_aea_old_1.xml$//event[@name=\"AEA_OLD_1_BARON\"]/beaconType/visitedTooltip"
msgstr "这是男爵所在的位置。"

#: src-en/data/events_sector_aea_old_1.xml:250
msgid "data/events_sector_aea_old_1.xml$//event[@name=\"AEA_OLD_1_BARON\"]/text"
msgstr "你抵达信标，发现了一艘巨大而华丽的飞船，这一定就是男爵的座驾。如果你摧毁这艘"
"飞船，应该就能找到前往利尔米克核心世界的坐标。"

#: src-en/data/events_sector_aea_old_1.xml:253
msgid ""
"data/events_sector_aea_old_1.xml$//event[@name=\"AEA_OLD_1_BARON\"]/choice/text"
msgstr "与那艘飞船交战。"

#: src-en/data/events_sector_aea_old_1.xml:255
msgid ""
"data/events_sector_aea_old_1.xml$//event[@name=\"AEA_OLD_1_BARON\"]/choice/event/text"
msgstr "就在你启动武器的同时，男爵也做出了同样的反应。"

#: src-en/data/events_sector_aea_old_1.xml:257
msgid ""
"data/events_sector_aea_old_1.xml$//event[@name=\"AEA_OLD_1_BARON\"]/choice/event/choice/text"
msgstr "继续。"

#: src-en/data/events_sector_aea_old_1.xml:265
msgid ""
"data/events_sector_aea_old_1.xml$//event[@name=\"AEA_OLD_BARON_DESTROYED\"]/text"
msgstr "那艘华丽的飞船已被击败。留下了大量废料可供拾取。"

#: src-en/data/events_sector_aea_old_1.xml:269
msgid ""
"data/events_sector_aea_old_1.xml$//event[@name=\"AEA_OLD_BARON_DESTROYED\"]/choice/text"
msgstr "继续。"

#: src-en/data/events_sector_aea_old_1.xml:271
msgid ""
"data/events_sector_aea_old_1.xml$//event[@name=\"AEA_OLD_BARON_DESTROYED\"]/choice/event/text"
msgstr "当你搜寻残骸以寻找利尔米克核心世界的坐标时，发现了一个完好无损的储物箱。过了"
"一会儿，你还找到了坐标。"

#: src-en/data/events_sector_aea_old_1.xml:276
msgid ""
